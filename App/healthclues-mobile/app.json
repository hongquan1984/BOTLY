{
  "expo": {
    "name": "HealthClues",
    "slug": "healthclues-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.botly.healthclues"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1b18"
      },
      "package": "vn.botly.healthclues"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-notifications"
    ],
    "scheme": "healthclues"
  }
}
