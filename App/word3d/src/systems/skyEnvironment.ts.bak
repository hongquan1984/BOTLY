import * as THREE from 'three';

export interface SkyEnvironmentResult {
  group: THREE.Group;
  sunLight: THREE.DirectionalLight;
  ambientLight: THREE.AmbientLight;
  hemiLight: THREE.HemisphereLight;
  update: (time: number) => void;
}

export function createSkyEnvironment(scene: THREE.Scene): SkyEnvironmentResult {
  const group = new THREE.Group();
  group.name = 'SkyAndEnvironment';

  // 1. Soft atmospheric fog matching the crystal azure horizon
  scene.fog = new THREE.FogExp2('#bae6fd', 0.005);

  // 2. High-Altitude Sky Dome with rich fantasy gradient
  const skyGeo = new THREE.SphereGeometry(260, 32, 20);

  const skyMat = new THREE.ShaderMaterial({
    uniforms: {
      topColor: { value: new THREE.Color('#1d4ed8') },      // Deep vibrant fantasy cobalt blue
      horizonColor: { value: new THREE.Color('#7dd3fc') },  // Luminous crystal azure horizon
      bottomColor: { value: new THREE.Color('#bae6fd') },   // Soft pale azure cloud mist below
      exponent: { value: 0.75 },
    },
    vertexShader: `
      varying vec3 vWorldPosition;
      void main() {
        vec4 worldPosition = modelMatrix * vec4(position, 1.0);
        vWorldPosition = worldPosition.xyz;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      uniform vec3 topColor;
      uniform vec3 horizonColor;
      uniform vec3 bottomColor;
      uniform float exponent;
      varying vec3 vWorldPosition;

      void main() {
        float h = clamp(vWorldPosition.y / 200.0, -1.0, 1.0);
        vec3 color;
        if (h >= 0.0) {
          color = mix(horizonColor, topColor, pow(h, exponent));
        } else {
          color = mix(horizonColor, bottomColor, pow(-h, exponent * 0.8));
        }
        gl_FragColor = vec4(color, 1.0);
      }
    `,
    side: THREE.BackSide,
    depthWrite: false,
  });

  const skyMesh = new THREE.Mesh(skyGeo, skyMat);
  group.add(skyMesh);

  // 3. Distant Mountain Silhouettes in Atmospheric Mist
  const mountainCount = 20;
  const mountainGeo = new THREE.ConeGeometry(38, 70, 5);
  const mountainMat = new THREE.MeshBasicMaterial({
    color: '#93c5fd',
    transparent: true,
    opacity: 0.38,
    depthWrite: false,
  });

  for (let i = 0; i < mountainCount; i++) {
    const angle = (i / mountainCount) * Math.PI * 2 + Math.sin(i * 1.5) * 0.25;
    const dist = 210 + (i % 4) * 15;
    const m = new THREE.Mesh(mountainGeo, mountainMat);
    const hScale = 0.5 + Math.sin(i * 2.8) * 0.35 + (i % 3) * 0.25;
    m.scale.set(0.9 + (i % 3) * 0.3, hScale, 0.9 + (i % 2) * 0.3);
    m.position.set(
      Math.cos(angle) * dist,
      -25 + (hScale * 70) * 0.4,
      Math.sin(angle) * dist
    );
    group.add(m);
  }

  // 4. Cinematic Golden-Hour Sunlight
  const sunDir = new THREE.Vector3(0.55, 0.78, 0.45).normalize();
  const sunLight = new THREE.DirectionalLight('#fff4dc', 3.0);
  sunLight.position.copy(sunDir).multiplyScalar(55);
  sunLight.castShadow = true;
  sunLight.shadow.mapSize.set(2048, 2048);
  sunLight.shadow.camera.near = 10;
  sunLight.shadow.camera.far = 120;
  sunLight.shadow.camera.left = -24;
  sunLight.shadow.camera.right = 24;
  sunLight.shadow.camera.top = 24;
  sunLight.shadow.camera.bottom = -24;
  sunLight.shadow.bias = -0.0004;
  sunLight.shadow.normalBias = 0.035;
  group.add(sunLight);

  // 5. Hemisphere fill: soft crystal azure on top, warm forest/rock bounce from below
  const hemiLight = new THREE.HemisphereLight('#c7e8ff', '#4a3525', 1.05);
  group.add(hemiLight);

  // 6. Ambient Fill
  const ambientLight = new THREE.AmbientLight('#fff7ed', 0.5);
  group.add(ambientLight);

  // 7. Floating Cloud Ocean Layer below the island
  const cloudsGroup = new THREE.Group();
  cloudsGroup.position.y = -14;

  const cloudMat = new THREE.MeshStandardMaterial({
    color: '#ffffff',
    roughness: 0.88,
    metalness: 0.02,
    flatShading: true,
    transparent: true,
    opacity: 0.88,
  });

  const cloudGeo = new THREE.DodecahedronGeometry(1.2, 1);
  const cloudCount = 20;
  const cloudMeshes: { mesh: THREE.Group; speed: number; radius: number; angle: number }[] = [];

  for (let i = 0; i < cloudCount; i++) {
    const cloud = new THREE.Group();
    const puffCount = 5 + (i % 4);
    const baseScale = 3.0 + (i % 5) * 0.8;

    for (let p = 0; p < puffCount; p++) {
      const puff = new THREE.Mesh(cloudGeo, cloudMat);
      puff.position.set(
        (Math.sin(p * 2.1) - 0.5) * 4.5,
        (Math.cos(p * 1.7) - 0.5) * 1.8,
        (Math.sin(p * 3.3) - 0.5) * 3.8
      );
      const s = baseScale * (0.65 + (p % 3) * 0.25);
      puff.scale.set(s, s * 0.6, s);
      cloud.add(puff);
    }

    const radius = 26 + (i % 5) * 8;
    const angle = (i / cloudCount) * Math.PI * 2;
    cloud.position.set(Math.cos(angle) * radius, -2 + Math.sin(i * 1.2) * 3, Math.sin(angle) * radius);
    cloudsGroup.add(cloud);

    cloudMeshes.push({
      mesh: cloud,
      speed: 0.015 + (i % 3) * 0.008,
      radius,
      angle,
    });
  }

  group.add(cloudsGroup);

  return {
    group,
    sunLight,
    ambientLight,
    hemiLight,
    update: (time: number) => {
      // Gently drift clouds around the floating village
      for (const c of cloudMeshes) {
        c.angle += c.speed * 0.01;
        c.mesh.position.x = Math.cos(c.angle) * c.radius;
        c.mesh.position.z = Math.sin(c.angle) * c.radius;
        c.mesh.position.y += Math.sin(time * 0.8 + c.angle) * 0.003;
      }
    },
  };
}
