diff --git a/src/lib/admin-auth.ts b/src/lib/admin-auth.ts
new file mode 100644
index 0000000..18c16be
--- /dev/null
+++ b/src/lib/admin-auth.ts
@@ -0,0 +1,12 @@
+import 'server-only';
+import { timingSafeEqual } from 'node:crypto';
+
+export function isAdminRequest(request: Request) {
+  const expected = process.env.EBOOK_ADMIN_TOKEN;
+  if (!expected) return false;
+  const supplied = /^Bearer (.+)$/.exec(request.headers.get('authorization') || '')?.[1] || '';
+  const a = Buffer.from(supplied);
+  const b = Buffer.from(expected);
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
