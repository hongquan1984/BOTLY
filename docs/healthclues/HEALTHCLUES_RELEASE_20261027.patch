+          <p className="mt-1 text-sm">{discoveryTimeLabel(item)}</p>
+          {item.safetyNotes && <p className="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-950"><strong>Safety note:</strong> {item.safetyNotes}</p>}
+          <div className="mt-4 flex flex-wrap gap-2">
