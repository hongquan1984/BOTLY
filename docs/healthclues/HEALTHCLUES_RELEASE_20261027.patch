+    const candidates = matchHealthCluesDiscoveries(profile, items);
+    const latestById = new Map<string, HealthCluesActivity>();
+    for (const event of history) if (!latestById.has(event.content_id)) latestById.set(event.content_id, event);
+    return candidates.filter(item => !['tried', 'not_interested', 'skipped'].includes(latestById.get(item.id)?.action || '')).slice(0, 3);
+  }, [profile, items, history]);
+
+  async function checkIn(item: DiscoveryContent, action: HealthCluesActivity['action'], reason: string | null = null) {
+    if (!session) return;
+    try {
+      await recordHealthCluesActivity(item.id, action, reason, session);
+      const next = await loadHealthCluesActivity(session);
+      setHistory(next);
+      setReasonFor(null);
+      setMessage(action === 'tried' ? 'Added to your activity history.' : action === 'saved' ? 'Saved for later.' : action === 'not_interested' || action === 'skipped' ? 'We will suggest another reviewed resource.' : 'Check-in saved.');
+    } catch (cause) {
+      setMessage(cause instanceof Error ? cause.message : 'Could not save your check-in.');
+    }
+  }
+
+  async function openDiscovery(event: MouseEvent<HTMLAnchorElement>, item: DiscoveryContent) {
+    if (item.url.startsWith('http')) {
+      void checkIn(item, 'viewed');
+      return;
+    }
+    event.preventDefault();
+    await checkIn(item, 'viewed');
+    window.location.assign(item.url);
+  }
+
+  const weekStart = now - 7 * 24 * 60 * 60 * 1000;
+  const isLoading = !sessionReady || Boolean(session && loading);
+  const thisWeek = history.filter(row => new Date(row.occurred_at).getTime() >= weekStart);
+  const topics = new Set(thisWeek.map(row => items.find(item => item.id === row.content_id)?.topicTags ?? []).flat());
+
+  return <main className="mx-auto max-w-5xl px-5 py-12 lg:px-8">
+    <p className="text-xs font-extrabold uppercase tracking-[.18em] text-emerald-800">HealthClues</p>
+    <h1 className="mt-2 text-3xl font-black text-[#18302b] sm:text-4xl">Your wellness discoveries</h1>
+    <p className="mt-3 max-w-2xl text-[#526b62]">A personal space for reviewed resources that match your interests. HealthClues does not diagnose or provide treatment.</p>
+    {isLoading && <p role="status" className="mt-8 rounded-2xl bg-[#f3f7f1] p-5">Loading your dashboard…</p>}
+    {!isLoading && !session && <section className="mt-8 rounded-2xl border border-[#dce8dc] p-6"><h2 className="text-xl font-bold">Sign in to continue</h2><p className="mt-2 text-sm text-[#526b62]">Your dashboard is available after you save a profile to your Botly account.</p><Link className="mt-4 inline-flex rounded-xl bg-[#18302b] px-5 py-3 font-bold text-white" href="/en/wellness/healthclues/quiz">Take the free quiz</Link></section>}
+    {!isLoading && session && error && <section role="alert" className="mt-8 rounded-2xl border border-amber-300 bg-amber-50 p-5"><p>{error}</p><button className="mt-3 underline" onClick={() => void refresh(session)}>Try again</button></section>}
+    {!isLoading && session && profile && !error && <>
