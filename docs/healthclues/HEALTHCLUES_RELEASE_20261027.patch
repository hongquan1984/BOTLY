+        loadHealthCluesActivity(current),
+        fetch('/api/healthclues/discoveries', { cache: 'no-store' }),
+      ]);
+      if (!isProfile(savedProfile)) throw new Error('No saved HealthClues profile was found. Take the quiz and choose to save it first.');
+      const payload = await response.json();
+      if (!response.ok) throw new Error('The reviewed discovery library is unavailable.');
+      setProfile(savedProfile);
+      setHistory(activity);
+      setItems(Array.isArray(payload.items) ? payload.items : []);
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : 'Could not load your dashboard.');
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (!session) return;
+    let cancelled = false;
+    queueMicrotask(() => { if (!cancelled) void refresh(session); });
+    return () => { cancelled = true; };
+  }, [session, refresh]);
+
+  const recommendations = useMemo(() => {
