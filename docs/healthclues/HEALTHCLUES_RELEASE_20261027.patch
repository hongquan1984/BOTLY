+"use client";
+
+import { useMemo, useState } from "react";
+import { Search } from "lucide-react";
+
+type PreviewQuestion = { id: string; group: string; stage: string; type: string; text: string; options: string[]; note_vi: string };
+
+export default function HealthCluesQuizPreviewPage() {
+  const [token, setToken] = useState("");
+  const [questions, setQuestions] = useState<PreviewQuestion[] | null>(null);
+  const [search, setSearch] = useState("");
+  const [showNotes, setShowNotes] = useState(true);
+  const [error, setError] = useState("");
+  const [loading, setLoading] = useState(false);
+  const visible = useMemo(() => questions?.filter(question => `${question.id} ${question.text} ${question.options.join(" ")}`.toLowerCase().includes(search.toLowerCase())) || [], [questions, search]);
+
+  async function load(event: React.FormEvent) {
+    event.preventDefault(); setLoading(true); setError("");
+    try {
+      const response = await fetch("/api/admin/healthclues-quiz", { headers: { Authorization: `Bearer ${token}` }, cache: "no-store" });
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error || "Could not load the quiz bank.");
+      setQuestions(result.questions as PreviewQuestion[]);
+    } catch (reason) { setError(reason instanceof Error ? reason.message : "Could not load the preview."); }
+    finally { setLoading(false); }
+  }
+
+  return <main className="min-h-screen bg-slate-950 px-4 py-10 text-slate-100 sm:px-8"><div className="mx-auto max-w-5xl">
+    <p className="text-xs font-bold uppercase tracking-[.2em] text-emerald-300">HEALTHCLUES · INTERNAL PREVIEW</p><h1 className="mt-2 text-3xl font-black">Quiz question bank</h1><p className="mt-2 text-sm text-slate-400">English questions and options with the Vietnamese owner notes underneath. Public quiz data excludes the Vietnamese notes.</p>
+    {!questions && <form onSubmit={load} className="mt-8 max-w-lg rounded-2xl border border-slate-800 bg-slate-900 p-5"><label htmlFor="hc-admin-token" className="text-sm font-semibold">Admin access token</label><input id="hc-admin-token" type="password" required value={token} onChange={event => setToken(event.target.value)} autoComplete="current-password" className="mt-2 min-h-11 w-full rounded-xl border border-slate-700 bg-slate-950 px-3"/><button disabled={loading} className="mt-3 rounded-xl bg-emerald-300 px-4 py-2.5 font-bold text-slate-950 disabled:opacity-50">{loading ? "Loading…" : "Open preview"}</button>{error && <p role="alert" className="mt-3 text-sm text-rose-300">{error}</p>}<p className="mt-3 text-xs text-slate-500">Uses the server configured `EBOOK_ADMIN_TOKEN`. The token is sent in the authorization header and is not stored.</p></form>}
+    {questions && <><div className="sticky top-0 z-10 mt-6 flex flex-col gap-3 border-y border-slate-800 bg-slate-950/95 py-4 backdrop-blur sm:flex-row sm:items-center"><label className="flex min-h-11 flex-1 items-center gap-2 rounded-xl border border-slate-700 px-3"><Search className="h-4 w-4 text-emerald-300"/><span className="sr-only">Search question bank</span><input value={search} onChange={event => setSearch(event.target.value)} placeholder="Search by ID or question" className="w-full bg-transparent text-sm outline-none"/></label><button type="button" aria-pressed={showNotes} onClick={() => setShowNotes(value => !value)} className="rounded-xl border border-slate-700 px-4 py-3 text-sm font-semibold">Admin notes: {showNotes ? "Hide" : "Show"}</button></div><div className="mt-5 space-y-4">{visible.map(question => <article key={question.id} className="rounded-2xl border border-slate-800 bg-slate-900 p-5"><div className="flex flex-wrap gap-2 text-[11px] font-bold uppercase tracking-wider text-emerald-300"><span>{question.id}</span><span>{question.group}</span><span>{question.stage}</span><span>{question.type}</span></div><h2 className="mt-3 text-lg font-bold">{question.text}</h2><ul className="mt-3 flex flex-wrap gap-2">{question.options.map(option => <li key={option} className="rounded-full bg-slate-800 px-3 py-1.5 text-sm">{option}</li>)}</ul>{showNotes && <p className="mt-4 border-t border-slate-800 pt-3 text-sm leading-relaxed text-amber-200"><strong>Ghi chú VN:</strong> {question.note_vi}</p>}</article>)}</div></>}
+  </div></main>;
+}
