+            <button onClick={() => void checkIn(item, 'skipped')} className="rounded-lg px-3 py-2.5 text-sm font-semibold underline">Try Something Else</button>
+          </div>
+          {reasonFor?.itemId === item.id && <div className="mt-4 rounded-xl bg-[#f7faf6] p-4">
+            <label className="text-sm font-semibold">{reasonFor.action === 'not_yet' ? 'What made this hard to try?' : 'What made this a poor fit?'} <select className="ml-2 rounded-lg border bg-white p-2" value={reasonFor.value} onChange={event => setReasonFor(current => current?.itemId === item.id ? { ...current, value: event.target.value as CheckInReason } : current)}>{reasons.map(([value, label]) => <option key={value} value={value}>{label}</option>)}</select></label>
+            <div className="mt-3 flex gap-3"><button onClick={() => void checkIn(item, reasonFor.action, reasonFor.value)} className="rounded-lg bg-[#18302b] px-4 py-2 text-sm font-bold text-white">Save check-in</button><button onClick={() => setReasonFor(null)} className="px-3 py-2 text-sm underline">Cancel</button></div>
+          </div>}
+        </article>)}</div> : <div className="mt-5 rounded-2xl border border-dashed p-5"><p className="text-sm text-[#526b62]">There are no other reviewed resources matching this profile right now. The library will not invent recommendations to fill the space.</p><div className="mt-3 flex gap-4"><Link className="underline" href="/en/wellness/guides">Browse wellness guides</Link><Link className="underline" href="/en/wellness/ebooks">Browse ebooks</Link></div></div>}
+      </section>
+
+      <section className="mt-9">
+        <h2 className="text-2xl font-black">This week</h2><p className="mt-1 text-sm text-[#71837b]">A seven-day summary of the check-ins you chose to save. It does not measure health outcomes.</p>
+        <dl className="mt-4 grid gap-3 sm:grid-cols-3">{[['Discoveries explored', thisWeek.filter(row => row.action === 'viewed').length], ['Activities tried', thisWeek.filter(row => row.action === 'tried').length], ['Saved resources', thisWeek.filter(row => row.action === 'saved').length], ['Topics explored', topics.size]].map(([label, count]) => <div key={label} className="rounded-xl bg-[#f3f7f1] p-4"><dt className="text-xs font-bold uppercase text-emerald-800">{label}</dt><dd className="mt-1 text-2xl font-black">{count}</dd></div>)}</dl>
+        <h3 className="mt-7 text-xl font-bold">Your history</h3>
+        <ol className="mt-4 max-h-72 space-y-2 overflow-y-auto">{history.map(event => <li key={event.id} className="rounded-lg border p-3 text-sm"><span className="font-semibold">{items.find(item => item.id === event.content_id)?.title ?? event.content_id}</span><span className="ml-2 text-[#71837b]">{event.action.replaceAll('_', ' ')} · {new Date(event.occurred_at).toLocaleDateString('en')}</span>{event.reason && <span className="block text-xs text-[#71837b]">Reason: {reasons.find(([value]) => value === event.reason)?.[1] ?? event.reason}</span>}</li>)}</ol>
+        <button className="mt-4 text-sm font-semibold text-rose-800 underline" onClick={async () => { if (!session || !window.confirm('Delete your HealthClues check-in history?')) return; try { await deleteHealthCluesActivity(session); setHistory([]); setMessage('Your check-in history was deleted.'); } catch (cause) { setMessage(cause instanceof Error ? cause.message : 'Could not delete history.'); } }}>Delete history</button>
