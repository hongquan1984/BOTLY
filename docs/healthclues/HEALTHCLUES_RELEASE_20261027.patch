+        <Link className="mt-4 inline-block text-sm font-bold text-emerald-900 underline" href="/en/wellness/healthclues/quiz?view=profile">Update preferences</Link>
+      </section>
+
+      <section className="mt-9">
+        <div className="flex flex-wrap items-end justify-between gap-3"><div><p className="text-xs font-bold uppercase tracking-widest text-emerald-800">{profile.refreshFrequency} refresh preference</p><h2 className="mt-1 text-2xl font-black">Your discoveries</h2></div><p className="max-w-md text-sm text-[#71837b]">The same reviewed recommendations stay available until you check in or request another option. No daily refresh is assumed.</p></div>
+        {recommendations.length ? <div className="mt-5 grid gap-4">{recommendations.map(item => <article key={item.id} className="rounded-2xl border border-[#dce8dc] bg-white p-5 shadow-sm">
+          <p className="text-xs font-extrabold uppercase tracking-wider text-emerald-800">{item.contentType === 'recipe' ? 'Food & recipes' : item.contentType === 'activity' ? 'Everyday wellness activity' : item.contentType === 'ebook' ? 'Reading guide' : 'Research & learn'}</p>
+          <h3 className="mt-2 text-xl font-bold text-[#18302b]">{item.title}</h3>
